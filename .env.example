# ─── Required ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token

# ─── Optional ────────────────────────────────────────────────────────────────
# Register commands in one guild only (instant updates while developing).
# Leave empty to register globally (can take up to ~1 hour to propagate).
GUILD_ID=

# Path/name of the yt-dlp executable. No API key, no account, no quota.
YT_DLP=yt-dlp

# Extra flags appended to EVERY yt-dlp call (search, link resolve and playback).
# Useful for cookies or PO tokens on sites that challenge anonymous clients.
# Example: YT_DLP_ARGS=--cookies /app/cookies.txt
# (player_client=tv,web_safari is already the default; --cookies-from-browser also works)
YT_DLP_ARGS=

# 0–200 (%). 100 is transparent / no gain.
DEFAULT_VOLUME=100

# Per-guild queue ceiling.
MAX_QUEUE=200

# Number of candidates shown in the search picker (max 25 for Discord menus).
SEARCH_RESULTS=10

# How long (seconds) a search result set is cached in memory.
SEARCH_CACHE_TTL=600

# Auto-leave voice after this many seconds with an empty queue (0 = never).
IDLE_TIMEOUT=300

# Opus encoder bitrate in bits/second (Discord allows up to ~384000).
# 128000 is transparent for source-quality WebM/Opus; 192000 for re-encoded audio.
OPUS_BITRATE=160000

# Accent colour of the embeds, as a hex RGB integer.
ACCENT=0x6C5CE7

# Custom application emojis (emojis.toml). With zero setup the bot uses
# generic Unicode emojis. Set to 1 once to upload the bundled gradient icons
# into YOUR application's emoji slots; later starts just look them up by name.
EMOJI_AUTO_UPLOAD=0

# Optional path to an edited emoji registry (default: the compiled
# emojis.toml). Useful in Docker without rebuilding the image.
# EMOJIS_FILE=/app/emojis.toml

# Optional: publicly host assets/*.jpg and put the base URL here.
# When set, Nexcord uses CDN URLs instead of uploading the tiny attachments.
# ASSET_BASE_URL=https://example.com/nexcord-assets

RUST_LOG=nexcord=info,songbird=warn,serenity=warn
